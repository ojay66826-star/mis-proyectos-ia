# Copia este archivo como .env y rellena SOLO las claves que quieras usar.
# El estudio funciona completo sin ninguna clave (motores locales).
# .env está en .gitignore: tus claves nunca se suben a GitHub.

# --- Guiones con IA (Claude) ------------------------------------------------
# https://console.anthropic.com/  → API Keys
ANTHROPIC_API_KEY=
# STUDIO_CLAUDE_MODEL=claude-opus-5-5

# --- Imágenes con IA ---------------------------------------------------------
# Hugging Face (cuenta gratis, con límite mensual): https://huggingface.co/settings/tokens
HF_TOKEN=
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# OpenAI (de pago): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# Stability AI (de pago, con créditos iniciales): https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# --- Video con IA ------------------------------------------------------------
# Replicate (pago por uso): https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Modelo imagen/texto→video (cámbialo si Replicate publica otro mejor):
# REPLICATE_VIDEO_MODEL=minimax/video-01
# REPLICATE_IMAGE_FIELD=first_frame_image

# --- Voces -------------------------------------------------------------------
# local (espeak-ng, por defecto) | elevenlabs | openai
STUDIO_TTS=local
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
